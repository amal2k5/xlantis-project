# ==============================================================================
# Xlantis RP Streamer & Content Directory - Backend Environment Variables
# Copy this file to .env in the backend/ directory and customize for your environment.
# ==============================================================================

# Django Core Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
# Option 1: Standard DATABASE_URL (takes precedence if provided)
DATABASE_URL=postgres://username:password@localhost:5432/xlantis_db

# Option 2: Discrete connection parameters (used when DATABASE_URL is not set)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=xlantis_db
DB_USER=username
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Application Settings
TIME_ZONE=UTC
LANGUAGE_CODE=en-us
